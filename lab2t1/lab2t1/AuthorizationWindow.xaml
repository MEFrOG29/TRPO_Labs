<Window x:Class="lab2t1.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab2t1"
        mc:Ignorable="d"
        Title="AuthorizationWindow" Height="350" Width="400">
    <Grid>
        <Label Content="Логин" x:Name="LoginLabel" HorizontalAlignment="Left" Margin="45,79,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Пароль" x:Name="PasswordLabel"  HorizontalAlignment="Left" Margin="45,140,0,0" VerticalAlignment="Top" FontSize="20"/>
        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" Margin="128,86,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="30" FontSize="16"/>
        <TextBox  x:Name="PasswordTextBox" HorizontalAlignment="Left" Margin="129,147,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="30" FontSize="16"/>
        <Button x:Name="ConfirmButton" Content="Войти" HorizontalAlignment="Center" Margin="0,224,0,0" VerticalAlignment="Top" Height="40" Width="144" FontSize="20" Click="ConfirmButton_Click"/>
        <TextBlock Margin="154,281,116,-65">
            <Hyperlink Click="Hyperlink_Click" FontSize="16">Регистрация</Hyperlink>
        </TextBlock>
    </Grid>
</Window>
