<Window x:Class="lab2t1.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab2t1"
        mc:Ignorable="d"
        Title="RegistrationWindow" Height="450" Width="400">
    <Grid>
        <Label Content="Имя" x:Name="NameLabel" HorizontalAlignment="Left" Margin="57,25,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Фамилия" x:Name="SurnameLabel" HorizontalAlignment="Left" Margin="33,65,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Логин" x:Name="LoginLabel" HorizontalAlignment="Left" Margin="45,107,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Пароль" x:Name="PasswordLabel"  HorizontalAlignment="Left" Margin="45,153,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Эл. почта" x:Name="EmailLabel"  HorizontalAlignment="Left" Margin="25,195,0,0" VerticalAlignment="Top" FontSize="20"/>
        <TextBox x:Name="NameTextBox" HorizontalAlignment="Left" Margin="128,30,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="30" FontSize="16"/>
        <TextBox  x:Name="SurnameTextBox" HorizontalAlignment="Left" Margin="129,70,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="30" FontSize="16"/>
        <TextBox  x:Name="LoginTextBox" HorizontalAlignment="Left" Margin="129,112,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="30" FontSize="16"/>
        <TextBox  x:Name="PasswordTextBox" HorizontalAlignment="Left" Margin="129,156,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="30" FontSize="16"/>
        <TextBox  x:Name="EmailTextBox" HorizontalAlignment="Left" Margin="129,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="200" Height="30" FontSize="16"/>
        <Button x:Name="RegistrationButton" Content="Зарегистрироваться" HorizontalAlignment="Center" Margin="0,285,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Height="62" Width="194" FontSize="16" Click="RegistrationButton_Click"/>
        <TextBlock Margin="152,369,115,10">
            <Hyperlink FontSize="16" Click="Hyperlink_Click">Авторизация</Hyperlink>
        </TextBlock>
    </Grid>
</Window>
